{
  "name": "@openproject/web-ifc-xeokit-metadata",
  "version": "0.0.2",
  "description": "Extracts the IFC structural hierarchy as xeokit-sdk metadata JSON. Drop-in replacement for the .NET-based bimspot/xeokit-metadata, built on web-ifc.",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "web-ifc-xeokit-metadata": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint . --ext .ts",
    "test": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opf/web-ifc-xeokit-metadata.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/opf/web-ifc-xeokit-metadata/issues"
  },
  "homepage": "https://github.com/opf/web-ifc-xeokit-metadata#readme",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "web-ifc": "^0.0.77"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.35.0",
    "@eslint/json": "^1.2.0",
    "@stylistic/eslint-plugin": "^5.3.1",
    "@types/node": "^25.0.2",
    "eslint": "^9.35.0",
    "globals": "^17.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
